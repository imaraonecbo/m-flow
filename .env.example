# M-FLOW runtime
M_FLOW_MODE=DISCOVERY
M_FLOW_PORT=8787
M_FLOW_DATA_DIR=./data
M_FLOW_LEDGER_FILE=./data/ledger.jsonl
M_FLOW_PROVIDER_CONFIG=./data/providers.json

# Financial scoring configuration. This is a scoring parameter, not a promised return.
# Example: 0.01 = 1% net profit per required-capital-day as the velocity target.
M_FLOW_VELOCITY_TARGET_PER_DAY=0.01
M_FLOW_PLATFORM_FEE=0

# PayPal adapter. Required ONLY for LIVE PayPal execution.
# Never commit real values.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

M_FLOW_AUTODISCOVERY_ENABLED=false
M_FLOW_DISCOVERY_INTERVAL_SECONDS=900
M_FLOW_DISCOVERY_LIMIT=25
M_FLOW_TED_QUERY=FT~"information technology" SORT BY publication-date DESC
SAM_API_KEY=
OPENCORPORATES_API_TOKEN=
M_FLOW_KENYA_PROCUREMENT_FEED_URL=
M_FLOW_CAPITAL_PROVIDER_FEED_URL=
M_FLOW_USER_AGENT=M-FLOW/1.0
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_KYB_LEVEL=
SIGNWELL_API_KEY=
RESEND_API_KEY=
M_FLOW_OUTREACH_FROM=
M_FLOW_ETIMS_VERIFY_URL=
M_FLOW_ETIMS_BEARER_TOKEN=
M_FLOW_ETIMS_CERTIFIED=false
